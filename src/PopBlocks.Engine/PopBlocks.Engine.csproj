<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure C# game rules. No MAUI / UI dependencies so it can be unit-tested without launching Android. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PopBlocks.Engine</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
