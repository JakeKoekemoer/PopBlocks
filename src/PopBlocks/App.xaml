<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PopBlocks.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette (mirrors Graphics/VisualDesign.cs) -->
            <Color x:Key="Background">#070A16</Color>
            <Color x:Key="Surface">#141B38</Color>
            <Color x:Key="Panel">#1F2850</Color>
            <Color x:Key="Line">#2F3B6B</Color>
            <Color x:Key="GlassFill">#B3141B38</Color>
            <Color x:Key="GlassStroke">#33FFFFFF</Color>
            <Color x:Key="TextPrimary">#F8FAFC</Color>
            <Color x:Key="TextSecondary">#9AA6C8</Color>
            <Color x:Key="Accent">#38BDF8</Color>
            <Color x:Key="Violet">#8B5CF6</Color>
            <Color x:Key="AccentText">#07101F</Color>
            <Color x:Key="GoldColor">#FFC83D</Color>
            <Color x:Key="Danger">#FB7185</Color>
            <Color x:Key="Overlay">#E8070A16</Color>

            <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A2250" Offset="0.0" />
                <GradientStop Color="#0B1028" Offset="0.5" />
                <GradientStop Color="#070A16" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22D3EE" Offset="0.0" />
                <GradientStop Color="#6366F1" Offset="0.55" />
                <GradientStop Color="#A855F7" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FDE047" Offset="0.0" />
                <GradientStop Color="#F59E0B" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Frosted-glass card -->
            <Style x:Key="Glass" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
                <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="22" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CaptionLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
            </Style>

            <Style x:Key="BodyLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="1.25" />
            </Style>

            <Style x:Key="ControlButtonBase" TargetType="Button">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="0.8" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="62" />
            </Style>

            <Style x:Key="ControlButton" TargetType="Button" BasedOn="{StaticResource ControlButtonBase}">
                <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderColor" Value="{StaticResource GlassStroke}" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>

            <Style x:Key="AccentControlButton" TargetType="Button" BasedOn="{StaticResource ControlButtonBase}">
                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="MinimumWidthRequest" Value="220" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderColor" Value="{StaticResource GlassStroke}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="MinimumWidthRequest" Value="220" />
            </Style>

            <!-- Quiet text-only button -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="34" />
            </Style>

            <!-- Round icon button (pause, back) -->
            <Style x:Key="RoundButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Panel}" />
                <Setter Property="BorderColor" Value="{StaticResource GlassStroke}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
