<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- PopBlocks is fully offline: deliberately NO <uses-permission> entries (no INTERNET, no ACCESS_NETWORK_STATE).
