<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PopBlocks.Views.WorldMapPage"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource PageGradient}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16,20,0" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Grid.Column="0" Text="←" Style="{StaticResource RoundButton}" FontSize="18" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="Map" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label x:Name="SummaryLabel" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="12,6" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8">
                    <GraphicsView x:Name="CoinView" InputTransparent="True" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Label x:Name="GoldLabel" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource GoldColor}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- The level you tapped: which level it is, which region it belongs to, which seed it was built from (for information
             and bug reports), and PLAY. Every player gets their own levels, so the seed is how a level can be talked about. -->
        <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label x:Name="DetailTitle" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Label x:Name="DetailRegion" Style="{StaticResource CaptionLabel}" />
                    <Label x:Name="DetailSeed" Style="{StaticResource CaptionLabel}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSeedTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="DetailHint" FontSize="11" TextColor="{StaticResource TextSecondary}" IsVisible="False" />
                </VerticalStackLayout>
                <Button x:Name="DetailPlay"
                        Grid.Column="1"
                        Text="PLAY"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="44"
                        MinimumWidthRequest="96"
                        CornerRadius="22"
                        FontSize="14"
                        Clicked="OnDetailPlayClicked" />
            </Grid>
        </Border>

        <ScrollView x:Name="Scroller" Grid.Row="2">
            <VerticalStackLayout x:Name="RegionsHost" Spacing="14" Padding="0,0,0,28" />
        </ScrollView>
    </Grid>
</ContentPage>
