<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PopBlocks.Views.WorldMapPage"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource PageGradient}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,16,20,0">
            <Button Grid.Column="0" Text="←" Style="{StaticResource RoundButton}" FontSize="18" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="Map" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label x:Name="SummaryLabel" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="12,6" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8">
                    <GraphicsView x:Name="CoinView" InputTransparent="True" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Label x:Name="GoldLabel" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource GoldColor}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- The journey: one pip per region, filled as the regions are restored. -->
        <Grid x:Name="JourneyHost" Grid.Row="1" ColumnSpacing="6" Margin="20,0" />

        <ScrollView x:Name="Scroller" Grid.Row="2">
            <VerticalStackLayout x:Name="RegionsHost" Spacing="12" Padding="20,0,20,24" />
        </ScrollView>

        <!-- The selected level and its PLAY button, pinned to the bottom. -->
        <ContentView x:Name="BarHost" Grid.Row="3" />
    </Grid>
</ContentPage>
