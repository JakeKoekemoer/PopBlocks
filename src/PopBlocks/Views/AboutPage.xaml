<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PopBlocks.Views.AboutPage"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource PageGradient}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" RowSpacing="8">
        <Button Grid.Row="0"
                Text="←"
                Style="{StaticResource RoundButton}"
                FontSize="18"
                HorizontalOptions="Start"
                Clicked="OnBackClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="4,8,4,32">

                <GraphicsView x:Name="LogoView"
                              HeightRequest="56"
                              WidthRequest="280"
                              HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="2">
                    <Label Text="PopBlocks"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />
                    <Label x:Name="VersionLabel"
                           Style="{StaticResource CaptionLabel}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- The dedication -->
                <Border Style="{StaticResource Glass}" Padding="24,24">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="A DEDICATION" Style="{StaticResource CaptionLabel}" TextColor="{StaticResource GoldColor}" />
                        <Label Text="For my wife."
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Style="{StaticResource BodyLabel}"
                               FontSize="15"
                               Text="So many of the games she loves are built to interrupt her: ads that ambush the screen, timers that nag, little tricks to part her from her money." />
                        <Label Style="{StaticResource BodyLabel}"
                               FontSize="15"
                               Text="She deserves a game that simply respects her time. PopBlocks is that game. It is made with love, and dedicated to her." />
                    </VerticalStackLayout>
                </Border>

                <!-- Promises -->
                <Border Style="{StaticResource Glass}" Padding="24,20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="OUR PROMISES" Style="{StaticResource CaptionLabel}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="✓" FontAttributes="Bold" TextColor="#39FF14" />
                            <Label Grid.Column="1" Text="No ads. Not now, not ever." Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="✓" FontAttributes="Bold" TextColor="#39FF14" />
                            <Label Grid.Column="1" Text="No tracking and no accounts. Your progress stays on your phone." Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="✓" FontAttributes="Bold" TextColor="#39FF14" />
                            <Label Grid.Column="1" Text="No internet needed. It works anywhere, even on a plane." Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="✓" FontAttributes="Bold" TextColor="#39FF14" />
                            <Label Grid.Column="1" Text="Gold is earned by playing, in the Story and by popping blocks in Classic. It can't be bought." Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="✓" FontAttributes="Bold" TextColor="#39FF14" />
                            <Label Grid.Column="1" Text="Stuck on a level? Swap it for a new one with a reroll. A reroll costs gold, a little less after every try, and it is free after 10 tries. Gold never stands between you and the story." Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="✓" FontAttributes="Bold" TextColor="#39FF14" />
                            <Label Grid.Column="1" Text="Your levels are yours. Each player gets their own, built on this phone and checked by a bot so they can always be won." Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- The in-game name: local only, travels only inside the player's own save code -->
                <Border Style="{StaticResource Glass}" Padding="24,20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="YOUR NAME" Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="NameLabel"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Style="{StaticResource BodyLabel}"
                               Text="Pip uses this name in the game. It stays on this phone and travels only inside your own save code. Changing the name never changes your levels." />
                        <Entry x:Name="NameEntry"
                               Placeholder="A new name"
                               MaxLength="20"
                               TextColor="{StaticResource TextPrimary}"
                               SemanticProperties.Description="A new name, up to 20 characters" />
                        <Button x:Name="RenameButton"
                                Text="RENAME"
                                Style="{StaticResource GhostButton}"
                                HeightRequest="46"
                                Clicked="OnRenameClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- Save code: progress moved by hand, no account and no network -->
                <Border Style="{StaticResource Glass}" Padding="24,20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="YOUR PROGRESS" Style="{StaticResource CaptionLabel}" />
                        <Label Style="{StaticResource BodyLabel}"
                               Text="PopBlocks keeps everything on this phone and never uploads it. To move to a new phone, or to keep a copy before reinstalling, copy your save code and paste it in on the other side." />
                        <Button x:Name="CopyButton"
                                Text="COPY MY SAVE CODE"
                                Style="{StaticResource GhostButton}"
                                HeightRequest="46"
                                Clicked="OnCopyCode"
                                SemanticProperties.Hint="Copies a line of text that holds your progress" />
                        <Editor x:Name="CodeEditor"
                                Placeholder="Paste a save code here"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="70"
                                FontSize="13"
                                TextColor="{StaticResource TextPrimary}"
                                SemanticProperties.Description="Save code to restore" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" x:Name="PasteButton" Text="PASTE" Style="{StaticResource GhostButton}" HeightRequest="46" Clicked="OnPasteCode" />
                            <Button Grid.Column="1" x:Name="RestoreButton" Text="RESTORE" Style="{StaticResource GhostButton}" HeightRequest="46" Clicked="OnRestoreCode" />
                        </Grid>
                        <Label x:Name="CodeStatus" Style="{StaticResource BodyLabel}" FontSize="13" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Thanks for playing."
                       Style="{StaticResource BodyLabel}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
