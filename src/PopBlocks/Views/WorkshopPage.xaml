<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PopBlocks.Views.WorkshopPage"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource PageGradient}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,16,20,0" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Grid.Column="0" Text="←" Style="{StaticResource RoundButton}" FontSize="18" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="Bram's Workshop" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label x:Name="SummaryLabel" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="12,6" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8">
                    <GraphicsView x:Name="CoinView" InputTransparent="True" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Label x:Name="GoldLabel" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource GoldColor}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- One tab per lamp. The lamp dot sits in the corner of its tab; the state is also written below. -->
        <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="3">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25" />
            </Border.StrokeShape>
            <Grid x:Name="TabBar" ColumnSpacing="2" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,0">
            <Label Grid.Column="0" x:Name="LampStateLabel" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
            <Label Grid.Column="1" x:Name="LampHintLabel" FontSize="12" LineHeight="1.25"
                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
        </Grid>

        <ContentView Grid.Row="3" x:Name="PanelHost" />
    </Grid>
</ContentPage>
