<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PopBlocks.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource PageGradient}">

    <Grid>

    <!-- First screen: just PLAY and MORE. MORE reveals the full menu below. -->
    <VerticalStackLayout x:Name="StartMenu"
                         VerticalOptions="Center"
                         Padding="32,0"
                         Spacing="18">
        <GraphicsView x:Name="StartLogoView"
                      HeightRequest="64"
                      WidthRequest="320"
                      HorizontalOptions="Center" />

        <Label Text="PopBlocks"
               FontSize="44"
               FontAttributes="Bold"
               CharacterSpacing="1"
               TextColor="{StaticResource TextPrimary}"
               HorizontalOptions="Center" />

        <Label Text="Connect four or more of a colour to pop them."
               Style="{StaticResource BodyLabel}"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center" />

        <Button x:Name="StartPlayButton"
                Text="PLAY"
                Style="{StaticResource PrimaryButton}"
                FontSize="22"
                HeightRequest="64"
                WidthRequest="260"
                HorizontalOptions="Center"
                Margin="0,24,0,0"
                Clicked="OnPlayClicked" />

        <Button x:Name="MoreButton"
                Text="MORE"
                Style="{StaticResource SecondaryButton}"
                WidthRequest="260"
                HorizontalOptions="Center"
                Clicked="OnMoreClicked" />
    </VerticalStackLayout>

    <!-- The full menu, as it always was. Shown by MORE. -->
    <ScrollView x:Name="FullMenu" IsVisible="False">
        <VerticalStackLayout Padding="24,20,24,28" Spacing="16">

            <Button Text="BACK"
                    Style="{StaticResource GhostButton}"
                    HorizontalOptions="Start"
                    Padding="0"
                    Margin="0,0,0,-8"
                    Clicked="OnBackToStartClicked" />

            <!-- Gold -->
            <Border Style="{StaticResource Glass}"
                    HorizontalOptions="End"
                    Padding="12,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8">
                    <GraphicsView x:Name="CoinView" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <Label x:Name="GoldLabel"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource GoldColor}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <GraphicsView x:Name="LogoView"
                          HeightRequest="64"
                          WidthRequest="320"
                          HorizontalOptions="Center"
                          Margin="0,4,0,0" />

            <Label Text="PopBlocks"
                   FontSize="44"
                   FontAttributes="Bold"
                   CharacterSpacing="1"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" />

            <Label Text="Connect four or more of a colour to pop them."
                   Style="{StaticResource BodyLabel}"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <!-- Story: continue where you left off -->
            <Border Style="{StaticResource Glass}" Padding="22,20" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="STORY" Style="{StaticResource CaptionLabel}" TextColor="{StaticResource Accent}" />
                    <Label x:Name="NextLevelLabel"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label x:Name="NextLevelDetail" Style="{StaticResource BodyLabel}" />
                    <Button x:Name="PlayButton"
                            Text="PLAY"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"
                            Clicked="OnPlayClicked" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="MAP" Style="{StaticResource SecondaryButton}"
                        MinimumWidthRequest="0" Clicked="OnMapClicked" />
                <Button Grid.Row="0" Grid.Column="1" Text="CLASSIC" Style="{StaticResource SecondaryButton}"
                        MinimumWidthRequest="0" Clicked="OnClassicClicked" />
                <Button Grid.Row="1" Grid.Column="0" Text="WORKSHOP" Style="{StaticResource SecondaryButton}"
                        MinimumWidthRequest="0" Clicked="OnShopClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="ARCHIVE" Style="{StaticResource SecondaryButton}"
                        MinimumWidthRequest="0" Clicked="OnArchiveClicked" />
                <Button Grid.Row="2" Grid.Column="0" Text="LEVELS" Style="{StaticResource GhostButton}"
                        HorizontalOptions="Center" Clicked="OnLevelsClicked" />
                <Button Grid.Row="2" Grid.Column="1" Text="TUTORIAL" Style="{StaticResource GhostButton}"
                        HorizontalOptions="Center" Clicked="OnTutorialClicked" />
            </Grid>

            <Label x:Name="BestLabel"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" />

            <!-- Classic seed: optional, and out of the way. A seed gives the same pieces again. It never touches the Story. -->
            <VerticalStackLayout Spacing="6">
                <Button x:Name="SeedLink"
                        Text="SEED"
                        Style="{StaticResource GhostButton}"
                        HorizontalOptions="Center"
                        Clicked="OnSeedLinkClicked"
                        SemanticProperties.Description="Classic seed. Optional: play Classic with a seed to get the same pieces again." />
                <Grid x:Name="SeedPanel" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="SeedEntry"
                           Keyboard="Numeric"
                           Placeholder="Classic seed (empty is random)"
                           MaxLength="10"
                           TextColor="{StaticResource TextPrimary}"
                           SemanticProperties.Description="Classic seed, a number from 0 to 2147483647. Leave empty for a random one." />
                    <Button Grid.Column="1" Text="CLEAR" Style="{StaticResource GhostButton}" Clicked="OnSeedClearClicked" />
                </Grid>
                <Label x:Name="SeedNote"
                       IsVisible="False"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       Text="A run with a seed still pays gold, but it never sets your best score." />
            </VerticalStackLayout>

            <!-- Settings -->
            <Border Style="{StaticResource Glass}" Padding="18,8" Margin="0,4,0,0">
                <VerticalStackLayout Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Pop effects" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                            <Label Text="Neon glow and burst when blocks pop" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Switch x:Name="EffectsSwitch"
                                Grid.Column="1"
                                OnColor="{StaticResource Accent}"
                                Toggled="OnEffectsToggled" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Landing guide" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                            <Label Text="Shows where the piece will land. Bold is thicker and easier to see." FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button x:Name="GuideButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                MinimumWidthRequest="0"
                                WidthRequest="120"
                                HeightRequest="40"
                                CornerRadius="20"
                                FontSize="13"
                                Clicked="OnGuideClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Reduced motion" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                            <Label Text="No screen shake, flashes or confetti. The game plays the same." FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Switch x:Name="MotionSwitch"
                                Grid.Column="1"
                                OnColor="{StaticResource Accent}"
                                Toggled="OnMotionToggled" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Sound effects" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                            <Label Text="Beeps for turning, placing, dropping and popping" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Switch x:Name="SoundSwitch"
                                Grid.Column="1"
                                OnColor="{StaticResource Accent}"
                                Toggled="OnSoundToggled" />
                    </Grid>
                    <Grid x:Name="BoardStyleRow" ColumnDefinitions="*,Auto" MinimumHeightRequest="48" IsVisible="False">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Board style" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                            <Label Text="Earned by restoring regions. Looks only." FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button x:Name="BoardStyleButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                MinimumWidthRequest="0"
                                WidthRequest="120"
                                HeightRequest="40"
                                CornerRadius="20"
                                FontSize="13"
                                Clicked="OnBoardStyleClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="ABOUT" Style="{StaticResource GhostButton}" HorizontalOptions="Center" Clicked="OnAboutClicked" />
            <Button x:Name="DevButton" Text="DEV MENU" Style="{StaticResource GhostButton}" TextColor="{StaticResource Danger}"
                    HorizontalOptions="Center" IsVisible="False" Clicked="OnDevClicked" />

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,8,0,0">
                <Label Text="HOW TO PLAY" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                <Label Style="{StaticResource BodyLabel}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       Text="Tap the board to rotate. Drag sideways to move. Drag down to soften the fall, or flick down to drop. The buttons below the board do the same, and can be folded away." />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <!-- First launch (and the first launch after names were added): what should Pip call you? Skippable. The name is only
         for the game; it never leaves the phone, and it never changes a level once chosen. -->
    <Grid x:Name="NamePrompt" IsVisible="False" BackgroundColor="#EE070A16">
        <Border Style="{StaticResource Glass}"
                BackgroundColor="#F2141B38"
                VerticalOptions="Center"
                Margin="24,0"
                Padding="22,22">
            <VerticalStackLayout Spacing="14">
                <Label Text="What should Pip call you?"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="Pick any name. It is only for the game and never leaves your phone."
                       Style="{StaticResource BodyLabel}"
                       FontSize="15" />
                <Entry x:Name="NameEntry"
                       Placeholder="Your name"
                       MaxLength="20"
                       ReturnType="Done"
                       TextColor="{StaticResource TextPrimary}"
                       Completed="OnNameContinueClicked"
                       SemanticProperties.Description="Your name, up to 20 characters" />
                <Button Text="CONTINUE" Style="{StaticResource PrimaryButton}" Clicked="OnNameContinueClicked" />
                <Button Text="SKIP" Style="{StaticResource SecondaryButton}" Clicked="OnNameSkipClicked"
                        SemanticProperties.Hint="Uses the name Traveller" />
            </VerticalStackLayout>
        </Border>
    </Grid>

    </Grid>
</ContentPage>
