<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PopBlocks.Views"
             x:Class="PopBlocks.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource PageGradient}">

    <Grid>

    <!-- First screen: just PLAY and MORE. MORE reveals the full menu below. -->
    <VerticalStackLayout x:Name="StartMenu"
                         VerticalOptions="Center"
                         Padding="32,0"
                         Spacing="18">
        <GraphicsView x:Name="StartLogoView" InputTransparent="True"
                      HeightRequest="64"
                      WidthRequest="320"
                      HorizontalOptions="Center" />

        <Label Text="PopBlocks"
               FontSize="44"
               FontAttributes="Bold"
               CharacterSpacing="1"
               TextColor="{StaticResource TextPrimary}"
               HorizontalOptions="Center" />

        <Label Text="Connect four or more of a colour to pop them."
               Style="{StaticResource BodyLabel}"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center" />

        <Button x:Name="StartPlayButton"
                Text="PLAY"
                Style="{StaticResource PrimaryButton}"
                FontSize="22"
                HeightRequest="64"
                WidthRequest="260"
                HorizontalOptions="Center"
                Margin="0,24,0,0"
                Clicked="OnPlayClicked" />

        <Button x:Name="MoreButton"
                Text="MENU"
                Style="{StaticResource SecondaryButton}"
                WidthRequest="260"
                HorizontalOptions="Center"
                Clicked="OnMoreClicked" />
    </VerticalStackLayout>

    <!-- The full menu, as it always was. Shown by MORE. -->
    <ScrollView x:Name="FullMenu" IsVisible="False">
        <VerticalStackLayout Padding="24,20,24,28" Spacing="16">

            <Button Text="BACK"
                    Style="{StaticResource GhostButton}"
                    HorizontalOptions="Start"
                    Padding="0"
                    Margin="0,0,0,-8"
                    Clicked="OnBackToStartClicked" />

            <!-- Gold -->
            <Border Style="{StaticResource Glass}"
                    HorizontalOptions="End"
                    Padding="12,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8">
                    <GraphicsView x:Name="CoinView" InputTransparent="True" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <Label x:Name="GoldLabel"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource GoldColor}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <GraphicsView x:Name="LogoView" InputTransparent="True"
                          HeightRequest="64"
                          WidthRequest="320"
                          HorizontalOptions="Center"
                          Margin="0,4,0,0" />

            <Label Text="PopBlocks"
                   FontSize="44"
                   FontAttributes="Bold"
                   CharacterSpacing="1"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" />

            <Label Text="Connect four or more of a colour to pop them."
                   Style="{StaticResource BodyLabel}"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <!-- Story: continue where you left off. The region picture behind the card is drawn once and cached. -->
            <Border x:Name="StoryCard" Style="{StaticResource Glass}" Padding="0" Margin="0,8,0,0" StrokeThickness="2">
                <Grid>
                    <GraphicsView x:Name="StoryCardScene" InputTransparent="True" />
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0007101F" Offset="0.0" />
                                <GradientStop Color="#B307101F" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <VerticalStackLayout Spacing="6" Padding="22,20">
                        <Label x:Name="StoryCaption" Text="STORY" Style="{StaticResource CaptionLabel}" TextColor="{StaticResource Accent}" />
                        <BoxView HeightRequest="56" Color="Transparent" InputTransparent="True" />
                        <Label x:Name="NextLevelLabel"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="NextLevelDetail" Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextPrimary}" />
                        <Button x:Name="PlayButton"
                                Text="CONTINUE"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,12,0,0"
                                Clicked="OnPlayClicked" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Settings sits right under CONTINUE: pop effects, landing guide, motion, sound, board style, rules, name and saved data
                 all live on their own page. -->
            <views:IconButton Icon="Settings" Text="SETTINGS" Clicked="OnSettingsClicked" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                <views:IconButton Grid.Row="0" Grid.Column="0" Icon="Map" Text="MAP" Clicked="OnMapClicked" />
                <views:IconButton Grid.Row="0" Grid.Column="1" Icon="Infinity" Text="ENDLESS" Clicked="OnClassicClicked" />
                <views:IconButton Grid.Row="1" Grid.Column="0" Icon="Cart" Text="WORKSHOP" Clicked="OnShopClicked" />
                <views:IconButton Grid.Row="1" Grid.Column="1" Icon="Book" Text="STORY BOOK" Clicked="OnArchiveClicked" />
                <views:IconButton Grid.Row="2" Grid.Column="0" Icon="Help" Text="TUTORIAL" Clicked="OnTutorialClicked" />
                <views:IconButton Grid.Row="2" Grid.Column="1" Icon="Info" Text="ABOUT" Clicked="OnAboutClicked" />
                <views:IconButton Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Icon="Share" Text="SHARE" Clicked="OnShareClicked"
                                  SemanticProperties.Description="Share PopBlocks with a friend" />
            </Grid>


            <Label x:Name="BestLabel"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" />

            <!-- Endless seed: optional, and out of the way. A seed gives the same pieces again. It never touches the Story. -->
            <VerticalStackLayout Spacing="6">
                <Button x:Name="SeedLink"
                        Text="SEED"
                        Style="{StaticResource GhostButton}"
                        HorizontalOptions="Center"
                        Clicked="OnSeedLinkClicked"
                        SemanticProperties.Description="Endless seed. Optional: play Endless with a seed to get the same pieces again." />
                <Grid x:Name="SeedPanel" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="SeedEntry"
                           Keyboard="Numeric"
                           Placeholder="Endless seed (empty is random)"
                           MaxLength="10"
                           TextColor="{StaticResource TextPrimary}"
                           SemanticProperties.Description="Endless seed, a number from 0 to 2147483647. Leave empty for a random one." />
                    <Button Grid.Column="1" Text="CLEAR" Style="{StaticResource GhostButton}" Clicked="OnSeedClearClicked" />
                </Grid>
                <Label x:Name="SeedNote"
                       IsVisible="False"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       Text="A run with a seed still pays gold, but it never sets your best score." />
            </VerticalStackLayout>

            <Button x:Name="DevButton" Text="DEV MENU" Style="{StaticResource GhostButton}" TextColor="{StaticResource Danger}"
                    HorizontalOptions="Center" IsVisible="False" Clicked="OnDevClicked" />

        </VerticalStackLayout>
    </ScrollView>

    <!-- First launch (and the first launch after names were added): what should Pip call you? Skippable. The name is only
         for the game; it never leaves the phone, and it never changes a level once chosen. -->
    <Grid x:Name="NamePrompt" IsVisible="False" BackgroundColor="#EE070A16">
        <Border Style="{StaticResource Glass}"
                BackgroundColor="#F2141B38"
                VerticalOptions="Center"
                Margin="24,0"
                Padding="22,22">
            <VerticalStackLayout Spacing="14">
                <Label Text="What should Pip call you?"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="Pick any name. It is only for the game and never leaves your phone."
                       Style="{StaticResource BodyLabel}"
                       FontSize="15" />
                <Entry x:Name="NameEntry"
                       Placeholder="Your name"
                       MaxLength="20"
                       ReturnType="Done"
                       TextColor="{StaticResource TextPrimary}"
                       Completed="OnNameContinueClicked"
                       SemanticProperties.Description="Your name, up to 20 characters" />
                <Button Text="CONTINUE" Style="{StaticResource PrimaryButton}" Clicked="OnNameContinueClicked" />
                <Button Text="SKIP" Style="{StaticResource SecondaryButton}" Clicked="OnNameSkipClicked"
                        SemanticProperties.Hint="Uses the name Traveller" />
                <!-- A reinstall that did not find its save file by itself: choose it by hand. -->
                <Button Text="I HAVE A SAVE FILE" Style="{StaticResource GhostButton}" Clicked="OnNameFindSaveClicked"
                        SemanticProperties.Hint="Choose a PopBlocks save file to restore your progress" />
            </VerticalStackLayout>
        </Border>
    </Grid>

    <!-- Shown after progress is restored from the first-launch prompt: the game has to be closed and opened again. -->
    <Grid x:Name="RestoredOverlay" IsVisible="False" BackgroundColor="#EE070A16">
        <Border Style="{StaticResource Glass}"
                BackgroundColor="#F2141B38"
                VerticalOptions="Center"
                Margin="24,0"
                Padding="22,22">
            <VerticalStackLayout Spacing="14">
                <Label Text="Progress restored"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Label x:Name="RestoredText"
                       Style="{StaticResource BodyLabel}"
                       FontSize="15" />
            </VerticalStackLayout>
        </Border>
    </Grid>

    </Grid>
</ContentPage>
