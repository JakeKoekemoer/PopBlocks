<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android first. Other platforms can be added later by extending this list. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>PopBlocks</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>PopBlocks</ApplicationTitle>
    <ApplicationId>com.popblocks.game</ApplicationId>
    <ApplicationDisplayVersion>1.1.1</ApplicationDisplayVersion>
    <ApplicationVersion>7</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <!-- Release builds produce a directly installable .apk (the default would be an .aab for Play Store). -->
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">apk</AndroidPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dev menu: always in Debug builds; add it to a Release build with  dotnet build -c Release -p:DevMenu=true -->
    <DefineConstants Condition="'$(DevMenu)' == 'true'">$(DefineConstants);DEVMENU</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Launcher icon and splash are tiny SVGs. The board and blocks are drawn in code, not image files. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1220" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1220" BaseSize="128,128" />

    <!-- Workshop artwork only (shop icons and tab banners). They are used as they are, not scaled up per screen density. -->
    <MauiImage Include="Resources\Images\*.png" Resize="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PopBlocks.Engine\PopBlocks.Engine.csproj" />
  </ItemGroup>

</Project>
